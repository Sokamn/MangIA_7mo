        <item name="tabPaddingEnd">6dp</item>
        <item name="tabBackground">@color/primaryColor</item>
        <item name="tabTextAppearance">@style/AppTabTextAppearance</item>
        <item name="tabSelectedTextColor">@color/quaternaryColor</item>
