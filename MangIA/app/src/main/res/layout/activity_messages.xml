<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColor"
    tools:context=".MessagesActivity">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cstMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <EditText
                android:id="@+id/txpSearchAS2"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="30dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="30dp"
                android:background="@drawable/bg_search_recipe"
                android:elevation="5dp"
                android:ems="10"
                android:focusableInTouchMode="true"
                android:fontFamily="@font/manjaribold"
                android:hint="@string/sChat"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:padding="0dp"
                android:paddingStart="40dp"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:textColorHint="#ABABAB"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txvNickNameM" />

            <ImageView
                android:id="@+id/imvSearchADS2"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_marginStart="15dp"
                android:elevation="11dp"
                android:src="@drawable/asicon"
                app:layout_constraintBottom_toBottomOf="@+id/txpSearchAS2"
                app:layout_constraintStart_toStartOf="@+id/txpSearchAS2"
                app:layout_constraintTop_toTopOf="@+id/txpSearchAS2" />

            <TextView
                android:id="@+id/txvNickNameM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/manjaribold"
                android:text="Chats"
                android:textColor="#41803C"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvMessages"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="70dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rcvHorizontalUsers"
                tools:listitem="@layout/row_message" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvHorizontalUsers"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_marginTop="20dp"
                android:scrollbars="none"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txpSearchAS2"
                tools:itemCount="9"
                tools:listitem="@layout/user_horizontal_item" />

            <ImageView
                android:id="@+id/imageView4"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="35dp"
                android:src="@drawable/option_chat"
                app:layout_constraintBottom_toBottomOf="@+id/txvNickNameM"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/txvNickNameM" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>


    <com.etebarian.meowbottomnavigation.MeowBottomNavigation
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:mbn_backgroundBottomColor="@color/primaryColor"
        app:mbn_countBackgroundColor="#ff6f00"
        app:mbn_countTextColor="#ffffff"
        app:mbn_defaultIconColor="@color/transQuaternaryColor"
        app:mbn_rippleColor="#2f424242"
        app:mbn_selectedIconColor="@color/quaternaryColor"
        app:mbn_shadowColor="#1f212121" />
</androidx.constraintlayout.widget.ConstraintLayout>