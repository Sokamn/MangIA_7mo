<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/txvEveryone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="textEnd"
        android:fontFamily="@font/manjaribold"
        android:text="Eliminar para todos"
        android:textColor="@color/quaternaryColor"
        android:textStyle="bold|normal"
        android:textSize="16sp"
        android:padding="10dp" />

    <TextView
        android:id="@+id/txvCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="textEnd"
        android:fontFamily="@font/manjaribold"
        android:text="Cancelar"
        android:textColor="@color/quaternaryColor"
        android:textStyle="bold|normal"
        android:textSize="16sp"
        android:padding="10dp" />

    <TextView
        android:id="@+id/txvDeleteForMe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="textEnd"
        android:fontFamily="@font/manjaribold"
        android:text="Eliminar para mi"
        android:textColor="@color/quaternaryColor"
        android:textStyle="bold|normal"
        android:textSize="16sp"
        android:padding="10dp" />


</LinearLayout>