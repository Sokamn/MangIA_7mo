<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/primaryColor">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imvProfilePictureRC"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/userImageProfile"
        app:srcCompat="@drawable/profile_picture" />

    <TextView
        android:id="@+id/txvCommentRC"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="20dp"
        android:fontFamily="@font/manjarithin"
        android:text="@string/nName"
        android:textColor="@color/transQuaternaryColor"
        android:textSize="15sp"
        app:layout_constraintEnd_toStartOf="@+id/imvLikeRC"
        app:layout_constraintStart_toEndOf="@+id/imvProfilePictureRC"
        app:layout_constraintTop_toTopOf="@+id/imvProfilePictureRC" />

    <TextView
        android:id="@+id/txvTimePostRC"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="20dp"
        android:fontFamily="@font/manjariregular"
        android:text="2 h"
        android:textColor="@color/transQuaternaryColor"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imvProfilePictureRC"
        app:layout_constraintTop_toBottomOf="@+id/txvCommentRC" />

    <TextView
        android:id="@+id/txvSendRC"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="5dp"
        android:fontFamily="@font/manjariregular"
        android:text="@string/send"
        android:textColor="@color/transQuaternaryColor"
        android:textSize="15sp"
        app:layout_constraintStart_toEndOf="@+id/txvResponderRC"
        app:layout_constraintTop_toBottomOf="@+id/txvCommentRC" />

    <TextView
        android:id="@+id/txvResponderRC"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="5dp"
        android:fontFamily="@font/manjariregular"
        android:text="@string/answer"
        android:textColor="@color/transQuaternaryColor"
        android:textSize="15sp"
        app:layout_constraintStart_toEndOf="@+id/txvLikesRC"
        app:layout_constraintTop_toBottomOf="@+id/txvCommentRC" />

    <TextView
        android:id="@+id/txvLikesRC"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="5dp"
        android:fontFamily="@font/manjariregular"
        android:text="1234 Me gusta"
        android:textColor="@color/transQuaternaryColor"
        android:textSize="15sp"
        app:layout_constraintStart_toEndOf="@+id/txvTimePostRC"
        app:layout_constraintTop_toBottomOf="@+id/txvCommentRC" />

    <ImageView
        android:id="@+id/imvLikeRC"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/imvProfilePictureRC"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imvProfilePictureRC"
        app:srcCompat="@drawable/check" />
</androidx.constraintlayout.widget.ConstraintLayout>