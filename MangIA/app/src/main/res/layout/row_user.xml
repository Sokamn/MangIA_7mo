<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/primaryColor">


    <Button
        android:id="@+id/btnFollowRU"
        android:layout_width="100dp"
        android:layout_height="30dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/button_profile_follow"
        android:fontFamily="@font/manjaribold"
        android:text="@string/Following"
        android:padding="0dp"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:backgroundTint="@color/secundaryColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txvUNameRU"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="@font/manjarithin"
        android:text="@string/nName"
        android:textColor="@color/transQuaternaryColor"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="@+id/imvProfilePictureRU"
        app:layout_constraintStart_toEndOf="@+id/imvProfilePictureRU" />

    <TextView
        android:id="@+id/txvNNameRU"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="5dp"
        android:fontFamily="@font/manjaribold"
        android:text="@string/userName"
        android:textColor="@color/quaternaryColor"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/imvProfilePictureRU"
        app:layout_constraintTop_toTopOf="@+id/imvProfilePictureRU" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imvProfilePictureRU"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        app:shapeAppearanceOverlay="@style/userImageProfile"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/profile_picture" />

</androidx.constraintlayout.widget.ConstraintLayout>