<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColor"
    tools:context=".RegisterActivity">

    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/bglogin"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imvLogoR"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:contentDescription="@string/logo"
        app:layout_constraintBottom_toTopOf="@+id/cardView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo_nobg"
        tools:ignore="ImageContrastCheck" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="0dp"
        android:layout_height="560dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="30dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="50dp"
        app:cardElevation="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:id="@+id/lineSpnRegionR"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="8dp"
                android:background="@color/transSecundaryColor"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="@+id/txpPassR"
                app:layout_constraintEnd_toEndOf="@+id/txpMailR"
                app:layout_constraintStart_toStartOf="@+id/txpMailR" />

            <View
                android:id="@+id/lineSpnCountryR"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="8dp"
                android:background="@color/transSecundaryColor"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="@+id/txpCountryR"
                app:layout_constraintEnd_toEndOf="@+id/txpMailR"
                app:layout_constraintStart_toStartOf="@+id/txpMailR" />

            <Button
                android:id="@+id/btnContinueR"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="60dp"
                android:background="@drawable/rounded_button"
                android:fontFamily="@font/manjaribold"
                android:paddingBottom="0dp"
                android:text="@string/cntBtn"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="20sp"
                app:backgroundTint="@color/secundaryColor"
                app:layout_constraintBottom_toTopOf="@+id/txvLoginL2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.495"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/txvPLoginR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/manjariregular"
                android:text="@string/pLogin"
                android:textColor="@color/quaternaryColor"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnContinueR" />

            <TextView
                android:id="@+id/txvLoginL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="70dp"
                android:fontFamily="@font/manjaribold"
                android:text="@string/welcomeMangIA"
                android:textColor="@color/secundaryDarkColor"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.498"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txvLoginL2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manjariregular"
                android:text="@string/pbSettlet"
                android:textColor="#20681A"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.498"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/txpMailR"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="35dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="35dp"
                android:backgroundTint="@color/transSecundaryColor"
                android:ems="10"
                android:enabled="true"
                android:focusable="true"
                android:fontFamily="@font/manjarithin"
                android:hint="@string/mail"
                android:inputType="textEmailAddress"
                android:minHeight="48dp"
                android:textColor="@color/secundaryColor"
                android:textColorHint="@color/transSecundaryColor"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txvLoginL" />

            <EditText
                android:id="@+id/txpTelR"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="35dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="35dp"
                android:backgroundTint="@color/transSecundaryColor"
                android:ems="10"
                android:fontFamily="@font/manjarithin"
                android:maxLength="15"
                android:hint="@string/tel"
                android:inputType="phone"
                android:minHeight="48dp"
                android:textColor="@color/secundaryColor"
                android:textColorHint="@color/transSecundaryColor"
                android:enabled="true"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txpMailR" />
            <EditText
                android:id="@+id/txpNNameR"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="35dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="35dp"
                android:backgroundTint="@color/transSecundaryColor"
                android:ems="10"
                android:hint="@string/nName"
                android:digits="ABCDEFGHIJKLMNÑOPQRSTUVWXYZabcdefghijklmnñopqrstuvwxyz0123456789_"
                android:inputType="textPersonName"
                android:maxLength="15"
                android:minHeight="48dp"
                android:fontFamily="@font/manjarithin"
                android:textColorHint="@color/transSecundaryColor"
                android:textColor="@color/secundaryColor"
                android:enabled="true"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txpUserNameR" />

            <EditText
                android:id="@+id/txpUserNameR"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="35dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="35dp"
                android:digits="abcdefghijklmnñopqrstuvwxyz1234567890_"
                android:maxLength="15"
                android:backgroundTint="@color/transSecundaryColor"
                android:ems="10"
                android:hint="@string/userName"
                android:inputType="textPersonName"
                android:minHeight="48dp"
                android:fontFamily="@font/manjarithin"
                android:textColorHint="@color/transSecundaryColor"
                android:textColor="@color/secundaryColor"
                android:enabled="true"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txpTelR" />

            <EditText
                android:id="@+id/txpDateBirthR"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="35dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="35dp"
                android:backgroundTint="@color/transSecundaryColor"
                android:clickable="false"
                android:ems="10"
                android:focusable="false"
                android:fontFamily="@font/manjarithin"
                android:hint="@string/dateBirth"
                android:textColor="@color/secundaryColor"
                android:textColorHint="@color/transSecundaryColor"
                android:visibility="invisible"
                android:enabled="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txpTelR" />

            <Spinner
                android:id="@+id/txpCountryR"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="35dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="35dp"
                android:backgroundTint="@color/transSecundaryColor"
                android:dropDownVerticalOffset="40dp"
                android:visibility="invisible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="@+id/txpRegionR"
                app:layout_constraintTop_toBottomOf="@+id/txpMailR" />

            <Spinner
                android:id="@+id/txpRegionR"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="35dp"
                android:layout_marginEnd="35dp"
                android:backgroundTint="@color/transSecundaryColor"
                android:dropDownVerticalOffset="40dp"
                android:visibility="invisible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/txpMailR" />

            <EditText
                android:id="@+id/txpPassR"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="35dp"
                android:layout_marginEnd="35dp"
                android:backgroundTint="@color/transSecundaryColor"
                android:ems="10"
                android:enabled="true"
                android:focusable="true"
                android:fontFamily="@font/manjarithin"
                android:hint="@string/pass"
                android:inputType="textPassword"
                android:textColor="@color/secundaryColor"
                android:textColorHint="@color/transSecundaryColor"
                android:visibility="invisible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/txpMailR" />

            <EditText
                android:id="@+id/txpRepeatPassR"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="35dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="35dp"
                android:backgroundTint="@color/transSecundaryColor"
                android:ems="10"
                android:hint="@string/rPass"
                android:inputType="textPassword"
                android:visibility="invisible"
                android:fontFamily="@font/manjarithin"
                android:textColorHint="@color/transSecundaryColor"
                android:textColor="@color/secundaryColor"
                android:enabled="true"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txpPassR" />

            <Button
                android:id="@+id/btnCancelR"
                android:layout_width="220dp"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/rounded_button"
                android:fontFamily="@font/manjaribold"
                android:paddingBottom="0dp"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:visibility="invisible"
                app:backgroundTint="@color/quaternaryColor"
                app:layout_constraintBottom_toTopOf="@+id/txvPLoginR"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.495"
                app:layout_constraintStart_toStartOf="parent" />

            <Button
                android:id="@+id/btnContinueR2"
                android:layout_width="220dp"
                android:layout_height="50dp"
                android:layout_marginBottom="25dp"
                android:background="@drawable/rounded_button"
                android:fontFamily="@font/manjaribold"
                android:text="@string/cntBtn"
                android:textAllCaps="false"
                android:paddingBottom="0dp"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:visibility="invisible"
                app:backgroundTint="@color/secundaryColor"
                app:layout_constraintBottom_toTopOf="@+id/btnCancelR"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.495"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/txvTerminos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="35dp"
                android:layout_marginEnd="35dp"
                android:fontFamily="@font/manjariregular"
                android:justificationMode="inter_word"
                android:text="@string/termsConditions"
                android:textColor="@color/secundaryColor"
                android:textSize="18sp"
                android:visibility="invisible"
                app:layout_constraintBottom_toTopOf="@+id/btnContinueR2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txvLoginL" />


        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <ImageButton
        android:id="@+id/imbBackR"
        android:layout_width="30dp"
        android:layout_height="50dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/primaryColor"
        android:contentDescription="@string/cancel"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/btnback" />


</androidx.constraintlayout.widget.ConstraintLayout>